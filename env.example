# =============================================================================
# Z-Data Site Environment Variables — TEMPLATE
# =============================================================================
# DO NOT put real secrets in this file. Copy to `.env.local` for local development.
# Per SPEC §0: never fill real credentials during development.
# =============================================================================

# === Site ===
NEXT_PUBLIC_SITE_URL=https://z-data.io
NEXT_PUBLIC_SITE_NAME=Z-Data

# === Forms ===
# In development, leave ENABLE_EMAIL_SENDING=false and the destination as a dummy.
# Real values are only set on the production Vercel environment at launch time.
WHITEPAPER_NOTIFY_EMAIL=dev@example.test
ENABLE_EMAIL_SENDING=false

# Email service API key (LEAVE BLANK during development per SPEC §0.4).
RESEND_API_KEY=

# === Analytics (optional, leave empty initially) ===
NEXT_PUBLIC_GA_ID=
